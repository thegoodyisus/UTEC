    },
    {
      "name": "9. Adjunta la boleta PDF",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/chat/mensajes",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"sesion_id\": \"{{sesion_id}}\",\n  \"texto\": \"\",\n  \"adjunto\": {\n    \"nombre_archivo\": \"boleta_2026-10.pdf\",\n    \"tipo\": \"application/pdf\",\n    \"contenido_base64\": \"\"\n  }\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('paso = EN_PROCESO', () => pm.expect(pm.response.json().paso).to.eql(\"EN_PROCESO\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "10. Polling hasta el resultado",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/chat/sesiones/{{sesion_id}}",
        "header": []
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "setTimeout(function () {}, 4000);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const j = pm.response.json();",
              "const n = Number(pm.collectionVariables.get('intentos') || 0);",
              "if (j.paso === 'EN_PROCESO' && n < 10) { pm.collectionVariables.set('intentos', n + 1); postman.setNextRequest('10. Polling hasta el resultado'); }",
              "else { pm.collectionVariables.set('intentos', 0); pm.test('paso = FIN', () => pm.expect(pm.response.json().paso).to.eql(\"FIN\")); pm.test('solicitud.estado = PRE_APROBADA', () => pm.expect(pm.response.json().solicitud.estado).to.eql(\"PRE_APROBADA\")); pm.collectionVariables.set('solicitud_id', j.solicitud.solicitud_id); }"
            ]
          }
        }
      ]
    },
    {
      "name": "11. Mensaje despues de terminar (409)",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/chat/mensajes",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"sesion_id\": \"{{sesion_id}}\",\n  \"texto\": \"gracias\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 409', () => pm.response.to.have.status(409));",
              "pm.test('error.codigo = SESION_FINALIZADA', () => pm.expect(pm.response.json().error.codigo).to.eql(\"SESION_FINALIZADA\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "12. Limpieza: el banco cierra la solicitud (API Solicitudes)",
      "request": {
        "method": "POST",
        "url": "{{solicitudesUrl}}/solicitudes/{{solicitud_id}}/cierre",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"usuario_banco\": \"analista.demo\",\n  \"producto_final\": \"PLD-DEMO-0069\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('estado = CERRADA', () => pm.expect(pm.response.json().estado).to.eql(\"CERRADA\"));"
            ]
          }
        }
      ]
    }
  ]
