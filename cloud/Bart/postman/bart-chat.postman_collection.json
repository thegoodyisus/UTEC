{
  "info": {
    "name": "bart-chat",
    "description": "Conversacion completa con Bart (Groq sin historial; el estado vive en DynamoDB). Datos sinteticos, DNI 99990069. Correr TODA la coleccion en orden con el Runner; al final cierra la solicitud en la API Solicitudes para poder repetir.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://<api-id>.execute-api.us-east-1.amazonaws.com"
    },
    {
      "key": "solicitudesUrl",
      "value": "https://<api-id>.execute-api.us-east-1.amazonaws.com"
    },
    {
      "key": "sesion_id",
      "value": ""
    },
    {
      "key": "solicitud_id",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Abrir sesion: saludo (201)",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/chat/sesiones",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
              "pm.test('paso = INICIO', () => pm.expect(pm.response.json().paso).to.eql(\"INICIO\"));",
              "if (pm.response.code < 300) { pm.collectionVariables.set('sesion_id', pm.response.json().sesion_id); }"
            ]
          }
        }
      ]
    },
    {
      "name": "2. Fuera de tema: se queda en INICIO",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/chat/mensajes",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"sesion_id\": \"{{sesion_id}}\",\n  \"texto\": \"cual es la capital de Francia?\",\n  \"adjunto\": null\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('paso = INICIO', () => pm.expect(pm.response.json().paso).to.eql(\"INICIO\"));"
            ]
          }
        }
      ]
    },
