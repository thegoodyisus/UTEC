{
  "info": {
    "name": "bart-solicitudes",
    "description": "API Solicitudes + workflow Step Functions + Groq (datos sinteticos). Correr TODA la coleccion en orden con el Runner: crea 3 solicitudes, espera al workflow, acepta la contraoferta y al final cierra todo para poder repetir.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://<api-id>.execute-api.us-east-1.amazonaws.com"
    },
    {
      "key": "sol_pre",
      "value": ""
    },
    {
      "key": "sol_contra",
      "value": ""
    },
    {
      "key": "sol_doc",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Ofertas vigentes 99990016 (200)",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/clientes/99990016/ofertas",
        "header": []
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('5 ofertas', () => pm.expect(pm.response.json().ofertas.length).to.eql(5));"
            ]
          }
        }
      ]
    },
    {
