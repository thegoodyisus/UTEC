        "url": "{{baseUrl}}/solicitudes",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"dni\": \"99990016\",\n  \"oferta_id\": \"OF-2026-11-99990016-PLD\",\n  \"monto_solicitado\": 20000,\n  \"boleta\": {\n    \"nombre_archivo\": \"boleta_2026-10.pdf\",\n    \"contenido_base64\": \"\"\n  },\n  \"canal\": \"API\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 202', () => pm.response.to.have.status(202));",
              "pm.test('estado = EN_PROCESO', () => pm.expect(pm.response.json().estado).to.eql(\"EN_PROCESO\"));",
              "if (pm.response.code < 300) { pm.collectionVariables.set('sol_pre', pm.response.json().solicitud_id); }"
            ]
          }
        }
      ]
    },
