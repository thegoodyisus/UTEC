    {
      "name": "8. Resultado PLD 99990016 (PRE_APROBADA)",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/solicitudes/{{sol_pre}}",
        "header": []
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "setTimeout(function () {}, 4000);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const j = pm.response.json();",
              "const n = Number(pm.collectionVariables.get('intentos_pre') || 0);",
              "if (j.estado === 'EN_PROCESO' && n < 10) {",
              "  pm.collectionVariables.set('intentos_pre', n + 1);",
              "  postman.setNextRequest('8. Resultado PLD 99990016 (PRE_APROBADA)');",
              "} else { pm.collectionVariables.set('intentos_pre', 0); }",
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "if (pm.response.json().estado !== 'EN_PROCESO') {",
              "  pm.test('estado = PRE_APROBADA', () => pm.expect(pm.response.json().estado).to.eql(\"PRE_APROBADA\"));",
              "  pm.test('reglas evaluadas', () => pm.expect(pm.response.json().evaluacion.reglas_evaluadas.length).to.be.above(2));",
              "}"
            ]
          }
        }
      ]
    },
