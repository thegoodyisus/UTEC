{
  "info": {
    "name": "bart-central-riesgo",
    "description": "Central de riesgo simulada de Bart (datos sinteticos). Correr en orden.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://<api-id>.execute-api.us-east-1.amazonaws.com"
    }
  ],
  "item": [
    {
      "name": "1. RCC mas reciente (200)",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/rcc/99990031",
        "header": []
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('documento = DNI#99990031', () => pm.expect(pm.response.json().documento).to.eql(\"DNI#99990031\"));",
              "pm.test('es_sintetico = True', () => pm.expect(pm.response.json().es_sintetico).to.eql(true));",
              "pm.test('trae lineas', () => pm.expect(pm.response.json().lineas).to.be.an('array').that.is.not.empty);"
            ]
          }
        }
      ]
    },
    {
      "name": "2. RCC de un periodo (200)",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/rcc/99990031?periodo=2026-09",
        "header": []
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('periodo = 2026-09', () => pm.expect(pm.response.json().periodo).to.eql(\"2026-09\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "3. Cliente con deuda alta, banda ALTO (200)",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/rcc/99990019",
        "header": []
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('banda_endeudamiento = ALTO', () => pm.expect(pm.response.json().banda_endeudamiento).to.eql(\"ALTO\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "4. DNI invalido (400)",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/rcc/123",
        "header": []
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 400', () => pm.response.to.have.status(400));",
              "pm.test('error.codigo = DNI_INVALIDO', () => pm.expect(pm.response.json().error.codigo).to.eql(\"DNI_INVALIDO\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "5. Periodo invalido (400)",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/rcc/99990031?periodo=2026-13",
        "header": []
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 400', () => pm.response.to.have.status(400));",
              "pm.test('error.codigo = PARAMETRO_INVALIDO', () => pm.expect(pm.response.json().error.codigo).to.eql(\"PARAMETRO_INVALIDO\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "6. DNI sin RCC (404)",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/rcc/99999999",
        "header": []
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 404', () => pm.response.to.have.status(404));",
              "pm.test('error.codigo = RCC_NO_ENCONTRADO', () => pm.expect(pm.response.json().error.codigo).to.eql(\"RCC_NO_ENCONTRADO\"));"
            ]
          }
        }
      ]
    }
  ]
}
