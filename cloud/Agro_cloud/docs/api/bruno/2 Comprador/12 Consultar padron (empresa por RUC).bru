post {
  url: {{process.env.BASE_URL}}/padron/consulta
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{process.env.TOKEN_COMPRADOR}}
}

body:json {
  {
    "tipoDoc": "RUC",
    "documento": "{{process.env.RUC_COMPRADOR}}",
    "uso": "comprador"
  }
}

tests {
  test("codigo 200", function () {
    expect([200]).to.include(res.getStatus());
