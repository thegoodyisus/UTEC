meta {
  name: 16 Buscar campanas publicadas (papa, Cusco)
  type: http
  seq: 16
}

get {
  url: {{process.env.BASE_URL}}/campanas/publicadas?cultivo=papa&departamento=Cusco
  body: none
  auth: bearer
}

params:query {
  cultivo: papa
  departamento: Cusco
}

auth:bearer {
  token: {{process.env.TOKEN_COMPRADOR}}
}

tests {
  test("codigo 200", function () {
    expect([200]).to.include(res.getStatus());
  });
}

docs {
  # Buscar campanas publicadas (papa, Cusco)

