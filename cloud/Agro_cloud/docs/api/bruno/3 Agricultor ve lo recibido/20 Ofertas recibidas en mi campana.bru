get {
  url: {{process.env.BASE_URL}}/campanas/{{campaniaId}}/ofertas
  body: none
  auth: bearer
}

auth:bearer {
  token: {{process.env.TOKEN_AGRICULTOR}}
}

tests {
  test("codigo 200", function () {
    expect([200]).to.include(res.getStatus());
  });
}

docs {
  # Ofertas recibidas en mi campana

  | | |
  |---|---|
  | API | `GET /campanas/{campaniaId}/ofertas` |
  | Token | agricultor |
  | Microservicio | Ofertas |
  | Tipo | lectura |
  | Tabla o servicio | agro-datos |
  | Operacion | Query PK=CAMP#<id>, SK empieza con OFFER# |
  | Esperado | 200 |

