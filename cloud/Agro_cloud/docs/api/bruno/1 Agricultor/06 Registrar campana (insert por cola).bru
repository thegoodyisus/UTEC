meta {
  name: 06 Registrar campana (insert por cola)
  type: http
  seq: 6
}

post {
  url: {{process.env.BASE_URL}}/campanas
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{process.env.TOKEN_AGRICULTOR}}
}

body:json {
  {
    "campaniaId": "{{$randomUUID}}",
    "cultivo": "papa",
    "departamento": "Cusco",
    "provincia": "Cusco",
    "distrito": "Wanchaq",
    "cosecha": "2027-06-15",
    "volumenKg": 2000,
    "logistica": "Recojo",
    "capital": "5000.00",
    "precioAhoraPorKg": "1.80",
    "precioContraentregaPorKg": "2.10"
  }
}

script:post-response {
  if (res.getStatus() === 202) {
    bru.setVar("campaniaId", res.getBody().recursoId);
  }
}

tests {
  test("codigo 202", function () {
    expect([202]).to.include(res.getStatus());
  });
}

docs {
  # Registrar campana (insert por cola)

  | | |
  |---|---|
  | API | `POST /campanas` |
  | Token | agricultor |
  | Microservicio | Campanas y fotos |
  | Tipo | escritura asincrona |
  | Tabla o servicio | SQS agro-insercion -> Lambda agro-worker -> agro-datos |
  | Operacion | la api lee CATALOGO y PROFILE y encola; el worker hace PutItem CAMP#<id> / META con indices por-usuario y publicadas-por-cultivo |
  | Esperado | 202 |

  Guarda `campaniaId` (de `recursoId` en la respuesta) para las peticiones siguientes.

  ## Respuesta real en AWS (2026-10-06 18:07 hora de Lima): 202

  ```json
  {
    "recursoId": "7e19831b-fbbe-4a8e-bfb9-b8716848d1e5",
    "estado": "PROCESANDO",
    "consultar": "/api/v1/campanas/7e19831b-fbbe-4a8e-bfb9-b8716848d1e5"
  }
  ```
}
