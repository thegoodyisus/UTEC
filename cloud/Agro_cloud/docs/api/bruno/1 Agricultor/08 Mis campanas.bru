meta {
  name: 08 Mis campanas
  type: http
  seq: 8
}

get {
  url: {{process.env.BASE_URL}}/campanas
  body: none
  auth: bearer
}

auth:bearer {
  token: {{process.env.TOKEN_AGRICULTOR}}
}

tests {
  test("codigo 200", function () {
    expect([200]).to.include(res.getStatus());
  });
}

docs {
  # Mis campanas

  | | |
  |---|---|
  | API | `GET /campanas` |
  | Token | agricultor |
  | Microservicio | Campanas y fotos |
  | Tipo | lectura |
  | Tabla o servicio | agro-datos (indice por-usuario) |
  | Operacion | Query usuarioClave=USER#<sub>, usuarioOrden empieza con CAMP# |
  | Esperado | 200 |

